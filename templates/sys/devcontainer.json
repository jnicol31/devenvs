{
  "name": "System tools",
  "image": "devenv-sys:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "root",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code"
  ],
  "updateRemoteUserUID": false,
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/dev/build/${localWorkspaceFolderBasename}\" \"${localEnv:HOME}/dev/cache/ansible\" \"${localEnv:HOME}/dev/cache/pip\" \"${localEnv:HOME}/dev/cache/ssh\" \"${localEnv:HOME}/dev/cache/claude\" && chmod 0700 \"${localEnv:HOME}/dev/cache/ssh\" \"${localEnv:HOME}/dev/cache/claude\"",
  "mounts": [
    "source=${localEnv:HOME}/dev/build/${localWorkspaceFolderBasename},target=/build,type=bind",
    "source=${localEnv:HOME}/dev/cache/ansible,target=/root/.ansible,type=bind",
    "source=${localEnv:HOME}/dev/cache/pip,target=/root/.cache/pip,type=bind",
    "source=${localEnv:HOME}/dev/cache/ssh,target=/root/.ssh,type=bind",
    "source=${localEnv:HOME}/dev/cache/claude,target=/root/.claude,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "runArgs": [
    "--cpus=4",
    "--memory=8g",
    "--label=home-server.ephemeral=true"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "foxundermoon.shell-format"
      ]
    }
  },
  "containerEnv": {
    "ANSIBLE_REMOTE_USER": "${localEnv:USER}",
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  }
}
